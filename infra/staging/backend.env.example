# Plantilla de la futura aplicación, NO credenciales para ejecutar.
# React y /api/v1 se sirven desde el MISMO origen. Sin / final.
ENVIRONMENT=staging
PUBLIC_APP_URL=https://REEMPLAZAR-STAGING.example.com
ALLOWED_HOSTS=["REEMPLAZAR-STAGING.example.com"]
CORS_ORIGINS=["https://REEMPLAZAR-STAGING.example.com"]
SESSION_AUTH_ENABLED=true
SESSION_COOKIE_SECURE=true
LOCAL_MAIL_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Provisionar un rol propio sin privilegios administrativos antes de usar esta URL.
DATABASE_URL=postgresql+psycopg://ROL_APP:SECRETO@HOST_PRIVADO/talentsync_staging?sslmode=require
SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_48_BYTES
STATIC_DIR=/app/static
CV_PARSER=pypdf
CV_OCR_ENABLED=false
# Sincronización y proveedores se habilitan después de configurar y comprobar cada integración.
WORKFLOW_MAINTENANCE_ENABLED=false
MODEL_MAINTENANCE_ENABLED=false
PERIODIC_MAINTENANCE_ENABLED=false
MATCH_MODEL_PATH=
AZURE_STORAGE_ACCOUNT_URL=https://REEMPLAZAR.blob.core.windows.net
AZURE_STORAGE_CONTAINER=cvs

# Calendar requiere consentimiento independiente del inicio social.
CALENDAR_SYNC_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
RESEND_WEBHOOK_SECRET=
MAIL_EVENT_RETENTION_DAYS=90
ACCOUNT_CLEANUP_ENABLED=true
# Activar tras aprobar y comunicar el plazo.
ACCOUNT_RETENTION_ENABLED=false
ACCOUNT_RETENTION_DAYS=90
