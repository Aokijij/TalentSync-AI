# Copy with: python scripts/local.py integrations --init
# Private destination: .local/integrations.env (ignored by Git).
# Plain KEY=value, no quotes, no variable expansion. Never paste secrets in chat.
INTEGRATIONS_ENABLED=false
PUBLIC_APP_URL=http://127.0.0.1:5173

# These credentials enable both candidate login and candidate registration.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# LinkedIn also requires an HTTPS origin and the OpenID Connect product.
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# Separate consent from login. Enable Calendar API in the Google project.
CALENDAR_SYNC_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=

# Explicit switch: local | resend | smtp. Existing local messages stay local.
INTEGRATION_MAIL_TRANSPORT=local
# Account mail requires your own verified sender; not onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
