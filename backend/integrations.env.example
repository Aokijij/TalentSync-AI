# TEMPLATE ONLY. Contains no credentials. Never overwrite an existing environment.
# For the isolated demo, add GitHub/Codewars/Learn values to .local/backend.env.
GITHUB_PROJECT_ANALYSIS_ENABLED=true
CODEWARS_ENABLED=true

# Learn Platform API: authenticated catalog metadata, no certificate validation.
LEARN_ENABLED=false
LEARN_TENANT_ID=
LEARN_CLIENT_ID=
LEARN_CLIENT_SECRET=

# Existing social login adapters. Optional; not needed for public project reading.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Resend: prepare now, enable only with a verified sender/domain and authorized test.
# scripts/local.py deliberately forces external mail OFF, even if these are set.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=

# Separate one-email smoke test: .local/resend.env (never in backend/.env).
# Run backend/.venv/Scripts/python.exe -X utf8 scripts/resend_test.py.
# The account email is the only recipient; the demo outbox is never processed.
# RESEND_TEST_ENABLED=true
# RESEND_API_KEY=<private Resend key>
# RESEND_FROM=onboarding@resend.dev
# RESEND_TEST_RECIPIENT=<email used to register the Resend account>
