APP_NAME=TalentSync AI
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://talentsync:CHANGE_ME@localhost:5432/talentsync
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
UPLOAD_DIR=uploads
STATIC_DIR=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=cvs
# Private R2 storage (alternative to Azure; use an Object Read & Write token scoped to this bucket)
R2_ENDPOINT_URL=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JOOBLE_API_KEY=
JOOBLE_API_BASE_URL=https://co.jooble.org/api
JOOBLE_TIMEOUT_SECONDS=20
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_API_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_TIMEOUT_SECONDS=20
JSEARCH_API_KEY=
JSEARCH_API_BASE_URL=https://api.openwebninja.com/jsearch/search-v2
JSEARCH_TIMEOUT_SECONDS=25
CATALOG_MAX_AGE_DAYS=60
CATALOG_MIN_SKILLS=3
EXTERNAL_JOB_CHECKS_ENABLED=false
INTEGRATION_HEALTH_CHECKS_ENABLED=false
CATALOG_TARGET_ACTIVE=100
PERIODIC_MAINTENANCE_ENABLED=false
PERIODIC_MAINTENANCE_INTERVAL_HOURS=24
PERIODIC_MAINTENANCE_INITIAL_DELAY_SECONDS=90
ALLOWED_HOSTS=["*"]
CV_PARSER=auto
# Optional isolated OCR interpreter, installed with requirements-ocr.txt.
CV_DOCLING_PYTHON=
CV_OCR_ENABLED=true
CV_OCR_FORCE_FULL_PAGE=false
CV_DOCLING_TIMEOUT_SECONDS=40
CV_DOCLING_MIN_TEXT_CHARS=200
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Delegated interview sync (separate consent from social login)
CALENDAR_SYNC_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
# Signed delivery events from Resend; never expose the signing secret in frontend
RESEND_WEBHOOK_SECRET=
# Project mailbox, send-only OAuth (separate from Google sign-in and Calendar)
GMAIL_MAIL_ENABLED=false
GMAIL_MAIL_CLIENT_ID=
GMAIL_MAIL_CLIENT_SECRET=
GMAIL_MAIL_REFRESH_TOKEN=
GMAIL_MAIL_SENDER=
MAIL_EVENT_RETENTION_DAYS=90
# Cleanup retry worker and approved metadata retention period
ACCOUNT_CLEANUP_ENABLED=true
ACCOUNT_RETENTION_ENABLED=false
ACCOUNT_RETENTION_DAYS=90
